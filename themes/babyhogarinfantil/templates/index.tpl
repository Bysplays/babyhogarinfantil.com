{extends file='page.tpl'}
{block name='page_content_container'}<div id="content" class="page-home bh-home"><section class="campaign" aria-label="Colecciones de Baby Hogar" aria-roledescription="carrusel"><div class="campaign-window"><div class="campaign-images"><div class="campaign-slide" role="group" aria-roledescription="diapositiva" aria-label="1 de 3: Niña" aria-hidden="false"><img src="{$urls.theme_assets}img/babyhogar/editorial-girl.jpg" alt="Campaña Niña de Baby Hogar Infantil" width="1600" height="800" fetchpriority="high"></div><div class="campaign-slide" role="group" aria-roledescription="diapositiva" aria-label="2 de 3: Niño" aria-hidden="true"><img src="{$urls.theme_assets}img/babyhogar/editorial-boy.jpg" alt="Campaña Niño de Baby Hogar Infantil" width="1600" height="800" ></div><div class="campaign-slide" role="group" aria-roledescription="diapositiva" aria-label="3 de 3: Bebé" aria-hidden="true"><img src="{$urls.theme_assets}img/babyhogar/editorial-baby.jpg" alt="Campaña Bebé de Baby Hogar Infantil" width="1600" height="800" ></div></div></div><a class="button campaign-cta" href="{$bh_catalog_url|default:$urls.pages.new_products}">Explorar la colección <span>↗</span></a><div class="campaign-label"><span>{$bh_season|default:'OTOÑO / INVIERNO — 26'|escape:'htmlall':'UTF-8'}</span></div><button class="campaign-arrow prev" data-prev aria-label="Fotografía anterior">‹</button><button class="campaign-arrow next" data-next aria-label="Fotografía siguiente">›</button><div class="campaign-dots" aria-label="Elegir fotografía"><button data-slide="0" aria-label="Ver fotografía 1: Niña" aria-current="true"><span></span></button><button data-slide="1" aria-label="Ver fotografía 2: Niño" aria-current="false"><span></span></button><button data-slide="2" aria-label="Ver fotografía 3: Bebé" aria-current="false"><span></span></button></div></section>
<section class="campaign-copy"><span class="eyebrow">BABY HOGAR INFANTIL</span><h1 id="campaign-title">PEQUEÑOS.<br><span>A LO GRANDE.</span></h1><p>Para saltar, descubrir y ser ellos mismos.<br>Moda que sigue su ritmo.</p></section>

{widget name='ps_newproducts'}
<section class="section universes"><div class="section-head"><div><span class="eyebrow">CADA ETAPA TIENE LO SUYO</span><h2>SU MUNDO. SU ESTILO.</h2></div><span class="section-note">Encuentra su próxima aventura.</span></div><div class="collections">
{foreach [['Bebé','baby','Todo empieza aquí.'],['Niño','boy','Sin parar de descubrir.'],['Niña','girl','A su manera.']] as $collection}<a class="collection" href="{$bh_collection_urls[$collection[0]]|default:$urls.pages.new_products}"><div class="photo"><img src="{$urls.theme_assets}img/babyhogar/editorial-{$collection[1]}.jpg" alt="Colección {$collection[0]}" loading="lazy" width="1600" height="800"></div><div class="collection-title"><h3>{$collection[0]} <span>↗</span></h3><p>{$collection[2]}</p></div></a>{/foreach}</div></section>
<section class="statement"><div><span class="eyebrow">HECHOS PARA MOVERSE</span><h2>QUE EL FRÍO<br>NO LES PARE.</h2><p>Capas suaves. Planes sin fin.<br>Descubre la selección de abrigo.</p><a class="button" href="{$urls.pages.search}?s=abrigo">Vamos fuera ↗</a></div><img src="{$urls.theme_assets}img/babyhogar/editorial-boy.jpg" alt="Campaña de invierno de Baby Hogar Infantil" loading="lazy" width="1600" height="800"></section>
{if !empty($bh_brands)}<section class="brands"><span class="eyebrow">SUS MARCAS. TUS FAVORITAS.</span><div class="brand-list">{foreach $bh_brands as $brand}<a href="{$brand.url}">{$brand.name|escape:'htmlall':'UTF-8'}</a>{/foreach}</div></section>{/if}
</div>{/block}